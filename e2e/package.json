{
  "name": "e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Browser end-to-end tests for a quiz night. The script is named e2e, not test, so `pnpm -r test` never runs it.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report playwright-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.58.1"
  }
}
