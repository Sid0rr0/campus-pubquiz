    "e2e:report": "playwright show-report playwright-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "eslint": "^9.18.0",
    "pg": "^8.16.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
