PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_pubquiz
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
FRONTEND_ORIGIN=http://localhost:8888
# Image uploads from the quiz editor. Create a PUBLIC store in Vercel → Storage → Blob,
# then copy its read/write token. Unset = uploads answer 503; the rest of the app is unaffected.
BLOB_READ_WRITE_TOKEN=
# Optional — which storage driver to use (default and only built-in: vercel-blob)
MEDIA_STORAGE_PROVIDER=
# Optional — leave unset to disable Sentry (it no-ops without a DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
