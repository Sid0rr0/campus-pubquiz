{
  "name": "campus-pubquiz",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "mkdir -p .logs && pnpm -r --parallel dev 2>&1 | tee .logs/dev.log",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @campus-pubquiz/types build && pnpm -r typecheck",
    "bootstrap": "pnpm install --frozen-lockfile && pnpm --filter @campus-pubquiz/types build",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter e2e run e2e",
    "e2e:ui": "pnpm --filter e2e run e2e:ui",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3"
  }
}
